{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BioContainers import (<id>.biocontainers.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "home_url", "identifiers", "license"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "home_url": {"type": ["string", "null"], "format": "url"},
    "identifiers": {
      "type": "array",
      "items": {"type": ["string", "null"], "format": "curie"}
    },
    "keywords": {"type": "array", "items": {"type": "string"}},
    "license": {"type": ["string", "null"]},
    "manually_check": {"type": "boolean"},
    "no_doi": {"type": "boolean"},
    "total_pulls": {"type": "integer", "minimum": 0}
  }
}
