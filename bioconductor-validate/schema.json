{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bioconductor import (<package>.bioconductor.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Package",
    "Version",
    "Title",
    "Description"
  ],
  "properties": {
    "Package": {
      "type": "string",
      "minLength": 1
    },
    "Version": {
      "type": "string",
      "format": "semverish"
    },
    "Title": {
      "type": "string"
    },
    "Description": {
      "type": "string"
    },
    "Author": {
      "type": "string"
    },
    "Authors@R": {
      "type": "string"
    },
    "Maintainer": {
      "type": "string"
    },
    "License": {
      "type": "string"
    },
    "License_restricts_use": {
      "type": "string"
    },
    "License_is_FOSS": {
      "type": "string"
    },
    "URL": {
      "type": "string"
    },
    "BugReports": {
      "type": "string",
      "format": "url"
    },
    "Video": {
      "type": "string"
    },
    "MD5sum": {
      "type": "string",
      "format": "md5"
    },
    "Date/Publication": {
      "anyOf": [
        {
          "type": "string",
          "format": "iso-date"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2} UTC$"
        }
      ]
    },
    "git_url": {
      "type": "string",
      "format": "url"
    },
    "git_branch": {
      "type": "string"
    },
    "git_last_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "git_last_commit_date": {
      "type": "string",
      "format": "iso-date"
    },
    "Depends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Imports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Suggests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Enhances": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "LinkingTo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependsOnMe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "importsMe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestsMe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linksToMe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencyCount": {
      "type": [
        "string",
        "integer"
      ]
    },
    "biocViews": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Rank": {
      "type": "integer"
    },
    "Archs": {
      "type": "string"
    },
    "NeedsCompilation": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "OS_type": {
      "type": "string"
    },
    "PackageStatus": {
      "type": "string"
    },
    "SystemRequirements": {
      "type": "string"
    },
    "VignetteBuilder": {
      "type": "string"
    },
    "vignettes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vignetteTitles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Rfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hasINSTALL": {
      "type": "boolean"
    },
    "hasLICENSE": {
      "type": "boolean"
    },
    "hasNEWS": {
      "type": "boolean"
    },
    "hasREADME": {
      "type": "boolean"
    },
    "source.ver": {
      "type": "string"
    },
    "win.binary.ver": {
      "type": "string"
    },
    "mac.binary.ver": {
      "type": "string"
    },
    "mac.binary.big-sur-x86_64.ver": {
      "type": "string"
    },
    "mac.binary.big-sur-arm64.ver": {
      "type": "string"
    },
    "mac.binary.sonoma-arm64.ver": {
      "type": "string"
    }
  }
}